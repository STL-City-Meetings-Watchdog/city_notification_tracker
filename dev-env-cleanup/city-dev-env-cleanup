#!/usr/bin/env bash
# city-dev-env-cleanup
#
# Decommissions ephemeral dev environments that haven't been deployed
# to in more than MAX_AGE_DAYS days.
#
# What it does per ephemeral environment:
#   1. Stop + remove all containers belonging to the branch (via Docker labels)
#   2. Remove all Docker networks belonging to the branch (via Docker labels)
#   3. Remove all Docker images whose name ends in -<environment_nickname>
#   4. rm -rf the persistence dir under /srv/dev/$ISSUE_ID
#
# Steps 1-3 are driven entirely by Docker's own label metadata, not by
# re-parsing a compose file. This means cleanup is correct regardless of
# which branch originally deployed the environment, and regardless of how
# many services that branch defined.
#
# Designed to be run by a systemd timer. Logs go to journald via stdout/stderr.

set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
MAX_AGE_DAYS="${MAX_AGE_DAYS:-2}"
DEV_BASE_DIR="${DEV_BASE_DIR:-/srv/dev}"
LOG_PREFIX="[city-dev-env-cleanup]"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
log()  { echo "$LOG_PREFIX $*"; }
warn() { echo "$LOG_PREFIX WARN: $*" >&2; }
die()  { echo "$LOG_PREFIX ERROR: $*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' not found in PATH"
}

require_cmd docker

# Age threshold in seconds
max_age_seconds=$(( MAX_AGE_DAYS * 86400 ))
now=$(date +%s)

log "Starting cleanup run. MAX_AGE_DAYS=${MAX_AGE_DAYS}, scanning ${DEV_BASE_DIR}"

# ---------------------------------------------------------------------------
# Find candidate environment directories
# Each dir is /srv/dev/<ISSUE_ID> and contains a last-deployed-timestamp sentinel file.
# ---------------------------------------------------------------------------
shopt -s nullglob
issue_dirs=( "$DEV_BASE_DIR"/[0-9]* )

if [[ ${#issue_dirs[@]} -eq 0 ]]; then
  log "No development environments found. Nothing to do."
  exit 0
fi

cleaned=0
skipped=0
errors=0

for issue_dir in "${issue_dirs[@]}"; do
  issue_id=$(basename "$issue_dir")

  # Guard: directory name must be purely numeric (the GitHub issue ID)
  if ! [[ "$issue_id" =~ ^[0-9]+$ ]]; then
    warn "Skipping non-numeric directory: $issue_dir"
    (( skipped++ )) || true
    continue
  fi

  sentinel="$issue_dir/last-deployed-timestamp"
  if [[ ! -f "$sentinel" ]]; then
    warn "No sentinel file found in $issue_dir — skipping (re-deploy or create the file manually to bring it under management)"
    (( skipped++ )) || true
    continue
  fi

  deployed_at=$(stat -c '%Y' "$sentinel")
  age_seconds=$(( now - deployed_at ))
  age_days=$(( age_seconds / 86400 ))
  environment_nickname="dev-${issue_id}"
  project_name="city-${environment_nickname}"

  if (( age_seconds < max_age_seconds )); then
    log "  ${project_name}: deployed ${age_days}d ago — keeping"
    (( skipped++ )) || true
    continue
  fi

  log "  ${project_name}: deployed ${age_days}d ago — decommissioning"

  # ------------------------------------------------------------------
  # 1. Stop + remove all containers belonging to this branch.
  #
  #    Uses the com.docker.compose.project label that Docker stamps on
  #    every container at `docker compose up` time. This is correct
  #    regardless of which branch deployed the environment or how many
  #    services it defined — no compose file re-parsing required.
  # ------------------------------------------------------------------
  log "    Stopping and removing containers for ${project_name}..."
  container_ids=$(
    docker ps -a \
      --filter "label=com.docker.compose.project=${project_name}" \
      --format '{{.ID}}'
  )
  if [[ -n "$container_ids" ]]; then
    if echo "$container_ids" | xargs docker rm -f 2>&1; then
      log "    Containers removed."
    else
      warn "    Failed to remove one or more containers for ${project_name} — skipping to avoid partial cleanup"
      (( errors++ )) || true
      continue
    fi
  else
    log "    No containers found for ${project_name} (already removed or never started)"
  fi

  # ------------------------------------------------------------------
  # 2. Remove networks belonging to this project.
  #
  #    Same label approach. The shared traefik-proxy network is not
  #    labelled with this project, so it will never match here.
  #    At time of writing we don't actually create any networks, so this
  #    code just natters in the log. 
  # ------------------------------------------------------------------
  log "    Removing networks for ${project_name}..."
  network_ids=$(
    docker network ls \
      --filter "label=com.docker.compose.project=${project_name}" \
      --format '{{.ID}}'
  )
  if [[ -n "$network_ids" ]]; then
    if echo "$network_ids" | xargs docker network rm 2>&1; then
      log "    Networks removed."
    else
      warn "    Failed to remove one or more networks for ${project_name}"
      # Non-fatal: leftover networks are untidy but don't leak compute or disk
    fi
  else
    log "    No networks found for ${project_name}"
  fi

  # ------------------------------------------------------------------
  # 3. Remove Docker images for this environment.
  #
  #    Docker does not stamp the project label onto images built with
  #    `docker compose up --build`, so we match by name suffix instead:
  #    any image whose repository name ends in -<environment_nickname>.
  #    This catches however many services exist in the branch that
  #    deployed this environment, without needing the compose file.
  # ------------------------------------------------------------------
  log "    Removing images for ${project_name}..."
  image_refs=$(
    docker images --format '{{.Repository}}:{{.Tag}}' \
      | grep -- "-${environment_nickname}:" || true
  )
  if [[ -n "$image_refs" ]]; then
    if echo "$image_refs" | xargs docker rmi 2>&1; then
      log "    Images removed."
    else
      warn "    Failed to remove one or more images for ${project_name} (may be in use elsewhere)"
      # Non-fatal: stale images waste disk but don't affect running state
    fi
  else
    log "    No images found for ${project_name}"
  fi

  # ------------------------------------------------------------------
  # 4. Remove persistence directory
  # ------------------------------------------------------------------
  log "    Removing persistence directory: ${issue_dir}"
  if rm -rf "$issue_dir"; then
    log "    Removed: ${issue_dir}"
  else
    warn "    Failed to remove: ${issue_dir}"
    (( errors++ )) || true
    continue
  fi

  log "  ${project_name}: decommissioned successfully"
  (( cleaned++ )) || true
done

log "Done. cleaned=${cleaned} skipped=${skipped} errors=${errors}"

if (( errors > 0 )); then
  exit 1
fi
